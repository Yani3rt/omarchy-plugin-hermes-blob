#!/usr/bin/python3
"""Refresh the desktop roster from a local Grok Bot agents directory.

Reads ``<dir>/*/profile.json`` and writes ``~/.config/omarchy/grokbot-bots.json``.
Descriptions are reduced to one public role line. Email addresses and home
paths are redacted. The webhook key is never read.

  grokbot-sync --from /path/to/agents
  grokbot-sync --seed data/bots.json

``agentsDir`` in ``~/.config/omarchy/grokbot-desktop.json`` or
``GROKBOT_AGENTS_DIR`` is used when ``--from`` is omitted.
"""
from __future__ import annotations

import argparse
import base64
import json
import os
import re
import stat
import sys
from urllib.parse import quote

MAX_PROFILE_BYTES = 256 * 1024
MAX_ROLE = 180
EMAIL = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}")
HOME_PATH = re.compile(r"/(?:home|Users)/[A-Za-z0-9._-]+(?:/[^\s,;)]*)?")
SAFE_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,80}$")
CONTROLS = re.compile(r"[\x00-\x1f\x7f]+")


def config_dir():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.environ.get("HOME", ""), ".config")
    return os.path.join(base, "omarchy")


def read_json(path, limit=MAX_PROFILE_BYTES):
    try:
        st = os.lstat(path)
    except OSError:
        return None
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        return None
    if st.st_size > limit:
        return None
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None


def desktop_config():
    data = read_json(os.path.join(config_dir(), "grokbot-desktop.json"), 64 * 1024)
    return data if isinstance(data, dict) else {}


def redact_role(text):
    raw = CONTROLS.sub(" ", str(text or ""))
    raw = EMAIL.sub("[redacted]", raw)
    raw = HOME_PATH.sub("[path]", raw)
    raw = " ".join(raw.split())
    if not raw:
        return ""
    sentence = re.split(r"(?<=[.!?])\s", raw, maxsplit=1)[0]
    role = sentence.strip()
    if len(role) > MAX_ROLE:
        role = role[: MAX_ROLE - 1].rstrip() + "…"
    return role


def short_name(name):
    text = str(name or "").strip()
    if " · " in text:
        return text.split(" · ", 1)[0].strip() or text
    return text


def safe_image(value):
    path = str(value or "")
    if not path.startswith("/") or len(path) > 512:
        return ""
    if "/../" in path or path.endswith("/..") or "/./" in path:
        return ""
    return path


def bot_from_profile(data):
    if not isinstance(data, dict):
        return None
    bot_id = str(data.get("id") or "").strip()
    name = str(data.get("name") or "").strip()
    if not SAFE_ID.fullmatch(bot_id) or not name or len(name) > 160:
        return None
    shape = str(data.get("avatarShape") or "blob").strip()
    color = str(data.get("avatarColor") or "blue").strip()
    if not re.fullmatch(r"[a-z]{3,16}", shape):
        shape = "blob"
    if not re.fullmatch(r"[a-z]{3,16}", color):
        color = "blue"
    bot = {
        "id": bot_id,
        "name": name,
        "shortName": short_name(name),
        "description": redact_role(data.get("description") or data.get("title") or ""),
        "avatarShape": shape,
        "avatarColor": color,
        "isPrimary": bool(data.get("isPrimary")),
    }
    image = safe_image(data.get("avatarImage"))
    if image:
        bot["avatarImage"] = image
    return bot


def inside(root, path):
    root_real = os.path.realpath(root)
    path_real = os.path.realpath(path)
    try:
        common = os.path.commonpath([root_real, path_real])
    except ValueError:
        return False
    return common == root_real


def collect(source):
    bots = []
    seen = set()
    try:
        names = sorted(os.listdir(source))
    except OSError as exc:
        raise SystemExit(f"cannot read {source}: {exc}") from exc
    for name in names:
        directory = os.path.join(source, name)
        profile = os.path.join(directory, "profile.json")
        if not inside(source, profile):
            continue
        try:
            if not stat.S_ISDIR(os.lstat(directory).st_mode):
                continue
        except OSError:
            continue
        bot = bot_from_profile(read_json(profile))
        if not bot or bot["id"] in seen:
            continue
        seen.add(bot["id"])
        bots.append(bot)
    bots.sort(key=lambda item: (not item["isPrimary"], item["shortName"].lower()))
    return bots


def app_roster():
    """Read only the signed-in account's last roster, never credentials or chats."""
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.environ.get("HOME", ""), ".config")
    cache = os.path.join(base, "Grok Bot", "sand-client-persistence")

    def cached(key, schema, limit):
        name = base64.b32encode(key.encode()).decode().lower().rstrip("=") + ".blob"
        data = read_json(os.path.join(cache, name), limit)
        if not isinstance(data, dict) or data.get("schemaVersion") != schema:
            raise ValueError("Open Grok Bot and let its bot list load, then try Sync again. The saved roster is missing or unsupported.")
        return data.get("value")

    account = cached("sand.client.slice.client-meta.account-slot", 1, 4096)
    if not isinstance(account, str) or not account or len(account) > 512:
        raise ValueError("Sign in to Grok Bot and load your bot list, then try Sync again.")
    key = "sand.client.slice.account." + quote(account, safe="~()*!.'-_") + ".roster.last-roster"
    value = cached(key, 4, 4 * 1024 * 1024)
    rows = value.get("rows") if isinstance(value, dict) else None
    if not isinstance(rows, list) or not rows or len(rows) > 500:
        raise ValueError("Grok Bot's saved roster is empty or unsupported. Your desktop bots have been kept.")
    bots = []
    seen = set()
    for row in rows:
        if not isinstance(row, dict):
            raise ValueError("Grok Bot's saved roster is invalid. Your desktop bots have been kept.")
        if row.get("isGroup") or row.get("isRemovedFromSidebar"):
            continue
        bot = bot_from_profile(row)
        if not bot or bot["id"] in seen:
            raise ValueError("Grok Bot's saved roster is invalid. Your desktop bots have been kept.")
        bot["isPrimary"] = bot["id"] == "e0195a7d-f804-4688-9191-e2cf3574a6d1"
        seen.add(bot["id"])
        bots.append(bot)
    if not bots:
        raise ValueError("No bots found in Grok Bot's saved roster. Your desktop bots have been kept.")
    return bots


HERMES_PROFILE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
PALETTE = {
    "black": (0x00, 0x00, 0x00), "brown": (0x93, 0x64, 0x39), "red": (0xFF, 0x26, 0x3C),
    "orange": (0xFF, 0x67, 0x00), "yellow": (0xFF, 0x98, 0x00), "green": (0x00, 0xC9, 0x72),
    "cyan": (0x00, 0xBC, 0xA6), "blue": (0x10, 0x84, 0xFE), "violet": (0x91, 0x59, 0xFE),
    "magenta": (0xFF, 0x30, 0x9B), "gray": (0x77, 0x77, 0x77),
}
# Hermes Bot Mode silhouettes that have no same-named companion shape.
HERMES_SHAPES = {"blobatar": "blob", "organic": "blob", "round": "blob", "boxy": "squircle",
                 "nub": "pebble", "sun": "burst"}
COMPANION_SHAPES = {
    "blob", "cloud", "squircle", "sparkle", "clover", "heart", "flower", "teardrop", "tablet",
    "wedge", "gem", "burst", "hex", "pebble", "circle", "dome", "crescent", "pumpkin", "drop",
    "egg", "bean", "leaf", "sprout", "pill", "capsule", "cylinder", "peanut", "triangle",
    "bolt", "pentagon", "shield", "crystal", "hexagon", "heptagon", "octagon", "square",
    "diamond", "arch", "ghost", "spark", "star",
}


def hermes_root():
    configured = str(desktop_config().get("hermesRoot") or "")
    if configured.startswith("/") and "/.." not in configured:
        return configured
    return os.path.join(os.environ.get("HOME", ""), ".hermes")


def parse_rgb(value):
    text = str(value or "").strip().lower()
    match = re.fullmatch(r"#([0-9a-f]{6})", text)
    if match:
        raw = match.group(1)
        return tuple(int(raw[i:i + 2], 16) for i in (0, 2, 4))
    match = re.fullmatch(r"hsla?\(\s*([\d.]+)(?:deg)?[\s,]+([\d.]+)%[\s,]+([\d.]+)%.*\)", text)
    if match:
        import colorsys
        h, s, l = (float(match.group(1)) % 360) / 360, float(match.group(2)) / 100, float(match.group(3)) / 100
        r, g, b = colorsys.hls_to_rgb(h, min(l, 1), min(s, 1))
        return (round(r * 255), round(g * 255), round(b * 255))
    return None


def nearest_color(value, fallback_seed):
    rgb = parse_rgb(value)
    if rgb is None:
        if str(value or "").strip().lower() in PALETTE:
            return str(value).strip().lower()
        # Stable per bot, so an undecorated profile keeps its colour across syncs.
        names = [name for name in PALETTE if name not in ("black", "gray", "brown")]
        return names[sum(fallback_seed.encode()) % len(names)]
    import colorsys
    hue, light, sat = colorsys.rgb_to_hls(*(c / 255 for c in rgb))
    best, best_score = "blue", None
    for name, ref in PALETTE.items():
        rh, rl, rs = colorsys.rgb_to_hls(*(c / 255 for c in ref))
        if sat < 0.15 or rs < 0.15:
            score = abs(light - rl) + (0 if (sat < 0.15) == (rs < 0.15) else 2)
        else:
            dh = min(abs(hue - rh), 1 - abs(hue - rh))
            score = dh * 4 + abs(light - rl) * 0.5
        if best_score is None or score < best_score:
            best, best_score = name, score
    return best


def nearest_shape(value):
    shape = str(value or "").strip().lower()
    shape = HERMES_SHAPES.get(shape, shape)
    return shape if shape in COMPANION_SHAPES else "blob"


def read_yaml(path):
    try:
        st = os.lstat(path)
    except OSError:
        return {}
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode) or st.st_size > MAX_PROFILE_BYTES:
        return {}
    try:
        import yaml
        with open(path, "r", encoding="utf-8") as handle:
            data = yaml.safe_load(handle)
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def hermes_roster(root=None, primary=None):
    """One bot per Hermes profile: the profile name is the bot id, so an ask can be
    routed to that profile's canonical Bot Chat. Only presentation metadata is read
    (profile.yaml title, description and Bot Mode look) — never config, keys or chats."""
    root = root or hermes_root()
    if not os.path.isdir(root):
        raise ValueError(f"No Hermes install found at {root}.")
    primary = str(primary or desktop_config().get("hermesPrimary") or "default")
    found = []
    if os.path.isfile(os.path.join(root, "config.yaml")):
        found.append(("default", root))
    profiles = os.path.join(root, "profiles")
    try:
        names = sorted(os.listdir(profiles))
    except OSError:
        names = []
    for name in names:
        directory = os.path.join(profiles, name)
        if not HERMES_PROFILE.fullmatch(name) or not inside(profiles, directory):
            continue
        try:
            if stat.S_ISDIR(os.lstat(directory).st_mode) and os.path.isfile(os.path.join(directory, "config.yaml")):
                found.append((name, directory))
        except OSError:
            continue
    bots = []
    for name, directory in found:
        meta = read_yaml(os.path.join(directory, "profile.yaml"))
        look = (meta.get("ui_meta") or {}).get("hermes-bots") if isinstance(meta.get("ui_meta"), dict) else None
        look = look if isinstance(look, dict) else {}
        if look.get("hidden") is True:
            continue
        title = str(look.get("title") or meta.get("display_name") or "").strip()
        label = title or name.replace("-", " ").replace("_", " ").title()
        bots.append({
            "id": name,
            "name": label[:160],
            "shortName": label[:160],
            "description": redact_role(meta.get("description") or ""),
            "avatarShape": nearest_shape(look.get("shape")),
            "avatarColor": nearest_color(look.get("color"), name),
            "isPrimary": name == primary,
        })
    if not bots:
        raise ValueError(f"No Hermes profiles found under {root}.")
    if not any(bot["isPrimary"] for bot in bots):
        bots[0]["isPrimary"] = True
    bots.sort(key=lambda item: (not item["isPrimary"], item["shortName"].lower()))
    return bots


def write_roster(path, bots):
    parent = os.path.dirname(path)
    os.makedirs(parent, mode=0o755, exist_ok=True)
    payload = json.dumps({"bots": bots}, indent=2) + "\n"
    temporary = path + ".tmp"
    with open(temporary, "w", encoding="utf-8") as handle:
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temporary, 0o644)
    os.replace(temporary, path)


def main(argv=None):
    parser = argparse.ArgumentParser(description="Refresh the Grok Bot desktop roster")
    parser.add_argument("--app", action="store_true", help="read the signed-in Grok Bot desktop app roster")
    parser.add_argument("--from", dest="source", help="agents directory containing */profile.json")
    parser.add_argument("--output", help="roster path (default: ~/.config/omarchy/grokbot-bots.json)")
    parser.add_argument("--seed", help="copy this JSON roster instead of reading profiles")
    parser.add_argument("--hermes", action="store_true", help="one bot per Hermes Agent profile")
    parser.add_argument("--auto", action="store_true",
                        help="--hermes when dispatch is hermes in grokbot-desktop.json, else --app")
    args = parser.parse_args(argv)
    output = args.output or os.path.join(config_dir(), "grokbot-bots.json")
    if args.auto:
        if str(desktop_config().get("dispatch") or "").lower() == "hermes":
            args.hermes = True
        else:
            args.app = True
    if args.hermes:
        if args.source or args.seed or (args.app and not args.auto):
            parser.error("--hermes cannot be combined with --app, --from or --seed")
        try:
            bots = hermes_roster()
            write_roster(output, bots)
        except (ValueError, OSError) as exc:
            print(str(exc), file=sys.stderr)
            return 1
        print(f"Synced {len(bots)} bots from Hermes.")
        return 0
    if args.app:
        if args.source or args.seed:
            parser.error("--app cannot be combined with --from or --seed")
        try:
            bots = app_roster()
            write_roster(output, bots)
        except (ValueError, OSError) as exc:
            print(str(exc), file=sys.stderr)
            return 1
        print(f"Synced {len(bots)} bots from Grok Bot.")
        return 0
    if args.seed:
        seeded = read_json(args.seed, 1024 * 1024)
        bots = seeded.get("bots") if isinstance(seeded, dict) else None
        if not isinstance(bots, list) or not bots:
            print("seed roster is empty", file=sys.stderr)
            return 2
        write_roster(output, bots)
        print(f"seeded {len(bots)} bots -> {output}")
        return 0
    source = args.source or os.environ.get("GROKBOT_AGENTS_DIR") or desktop_config().get("agentsDir") or ""
    source = str(source)
    if not source.startswith("/") or "/.." in source:
        print("pass --from DIR, set agentsDir, or set GROKBOT_AGENTS_DIR", file=sys.stderr)
        return 2
    bots = collect(source)
    if not bots:
        print("no profiles found", file=sys.stderr)
        return 1
    write_roster(output, bots)
    print(f"synced {len(bots)} bots -> {output}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

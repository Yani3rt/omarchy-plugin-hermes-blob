#!/usr/bin/env python3
"""Hermes Blob bridge: keep the companion attached to each bot's Hermes Bot Chat.

The shell starts this once, under Hermes' own Python (it uses Hermes' gateway
client, the same one `hermes chat`, the TUI and Desktop use). For every bot in
the roster that is a Hermes profile it attaches to that profile's canonical
"Bot Chat" session on the local gateway, as one more viewer, and then:

* submits asks the shell sends it (`prompt.submit`), and streams the reply back;
* reports turns it did not start — a teammate's late handoff reply, a routine,
  a turn from Desktop — so they land in that bot's conversation;
* interrupts a turn on Stop (`session.interrupt`), inside the gateway.

Authentication is the gateway's own: a one-use ticket from its private control
socket, which only this user's processes can reach. No API key is involved.

Transport to the shell is JSON Lines on stdin/stdout, never argv, so private
text never shows up in process listings. stderr carries diagnostics only and
never prompt or reply text.

  shell -> bridge   {"op": "ask", "askId", "bot", "text"}
                    {"op": "stop", "bot"}
                    {"op": "respond", "bot", "promptId", "choice"}   approve / deny
                    {"op": "answer", "bot", "promptId", "answer"}    clarify
                    {"op": "compact", "bot"}               like Desktop's /compact
                    {"op": "reload"}                       re-read the roster
  bridge -> shell   {"ev": "ready"}
                    {"ev": "status", "bot", "state": "up"|"down", "detail"?}
                    {"ev": "delta", "bot", "askId"?, "text"}     text so far
                    {"ev": "progress", "bot", "askId"?, "text"}
                    {"ev": "complete", "bot", "askId"?, "text", "status"}
                    {"ev": "error", "bot", "askId", "text", "code"}
                    {"ev": "prompt", "bot", "askId"?, "promptId", "kind", "text",
                     "command"?, "choices", "multiSelect"}
                    {"ev": "settled", "bot", "promptId"}         answered anywhere
                    {"ev": "responded", "bot", "promptId", "ok", "text"?}
                    {"ev": "compacted", "bot", "ok", "text"}
                    {"ev": "history", "bot", "items": [{"asked", "body"}]}  on attach
  A "complete" for a turn started elsewhere (Desktop, Telegram, a teammate) carries
  "asked" when the question is known.
"""
from __future__ import annotations

import asyncio
import json
import os
import re
import sqlite3
import sys
import uuid
from pathlib import Path

PROFILE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
ASK_ID = re.compile(r"^[0-9a-f]{8,32}$")
BOT_CHAT = "Bot Chat"
TEXT_LIMIT = 16000
# Same note the CLI path prepends; it is stored with the turn, so it stays short.
NOTE = "[via Omarchy desktop bubble: plain text only, a few short sentences]"
RETRY_MIN, RETRY_MAX = 2.0, 30.0
HISTORY_EXCHANGES = 20
SILENCE = re.compile(r"^\s*\[?(SILENT|NO_REPLY|NO REPLY)\]?\s*$", re.I)
# Rows Hermes itself marks as plumbing: never shown as something you asked.
HIDDEN_KINDS = {"process_complete", "internal_notification", "hidden", "compaction", "delivery"}
TOOL_LABELS = {
    "terminal": "Running a command", "process": "Checking a command", "execute_code": "Running code",
    "web_search": "Searching the web", "web_extract": "Reading a web page", "browser_exec": "Using the browser",
    "read_file": "Reading a file", "write_file": "Writing a file", "patch": "Editing a file",
    "search_files": "Searching files", "delegate_task": "Handing off to a helper",
    "clarify": "Asking you", "memory": "Checking memory", "skill_view": "Loading a skill",
    "skill_manage": "Updating a skill", "vision_analyze": "Looking at an image", "todo": "Planning",
    "cronjob": "Scheduling", "send_message": "Sending a message", "text_to_speech": "Recording audio",
}


TEAMMATE = re.compile(r"^Message from \S+ (.+?) \(@[^)]+\):\s*", re.S)


def strip_note(text: str) -> str:
    """What was asked, as the bubble shows it: without the companion's own note, and a
    teammate's DM labelled as theirs rather than looking like something you typed."""
    text = str(text or "")
    if text.startswith(NOTE):
        text = text[len(NOTE):]
    text = text.strip()
    match = TEAMMATE.match(text)
    if match:
        text = f"From {match.group(1)}: " + text[match.end():]
    return text


def tool_label(payload: dict) -> str:
    name = str(payload.get("tool_name") or payload.get("name") or "")
    args = payload.get("args") if isinstance(payload.get("args"), dict) else {}
    if name == "message_agent":
        target = str(args.get("target") or "").lstrip("@")[:40]
        return f"Messaging {target}…" if target else "Messaging a teammate…"
    if name.startswith("browser"):
        return "Using the browser…"
    if name.startswith("mnemosyne") or name.startswith("memory"):
        return "Checking memory…"
    label = TOOL_LABELS.get(name)
    return f"{label}…" if label else (f"Using {name[:48]}…" if name else "Working…")


def history_items(messages, limit=HISTORY_EXCHANGES) -> list[dict]:
    """The Bot Chat as the bubble shows it: what was asked and the final reply, oldest first.

    Tool rows, tool-call scaffolding and empty or silent replies are dropped; a turn Hermes
    started itself (a background result, a teammate's delivery) shows as the bot speaking."""
    items: list[dict] = []
    current = None
    for row in messages or []:
        if not isinstance(row, dict):
            continue
        role, content = row.get("role"), row.get("content")
        if not isinstance(content, str):
            continue
        if role == "user":
            if current and current["body"]:
                items.append(current)
            asked = "" if row.get("display_kind") in HIDDEN_KINDS else strip_note(content)
            current = {"asked": clip(asked)[:4000], "body": ""}
        elif role == "assistant" and content.strip() and not SILENCE.match(content):
            if current is None:
                current = {"asked": "", "body": ""}
            current["body"] = clip(content).strip()[:4000]
    if current and current["body"]:
        items.append(current)
    return items[-limit:]


def config_dir() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.environ.get("HOME", ""), ".config")
    return Path(base) / "omarchy"


def read_json(path: Path, limit: int = 1024 * 1024):
    try:
        if path.is_symlink() or not path.is_file() or path.stat().st_size > limit:
            return None
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def desktop_config() -> dict:
    data = read_json(config_dir() / "grokbot-desktop.json", 64 * 1024)
    return data if isinstance(data, dict) else {}


def hermes_root(conf: dict) -> Path:
    configured = str(conf.get("hermesRoot") or "")
    if configured.startswith("/") and "/.." not in configured:
        return Path(configured)
    return Path(os.environ.get("HOME", "")) / ".hermes"


def profile_home(root: Path, profile: str) -> Path:
    return root if profile == "default" else root / "profiles" / profile


def roster_profiles(root: Path) -> list[str]:
    data = read_json(config_dir() / "grokbot-bots.json")
    bots = data.get("bots") if isinstance(data, dict) else None
    out = []
    for bot in bots if isinstance(bots, list) else []:
        bot_id = str((bot or {}).get("id") or "")
        if PROFILE.fullmatch(bot_id) and (profile_home(root, bot_id) / "config.yaml").is_file() and bot_id not in out:
            out.append(bot_id)
    return out


def bot_chat_id(home: Path) -> str:
    """The profile's canonical Bot Chat: the newest unarchived session titled exactly "Bot Chat"."""
    path = home / "state.db"
    if not path.is_file():
        return ""
    try:
        db = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=5)
        try:
            row = db.execute(
                "select id from sessions where title = ? and coalesce(archived, 0) = 0 "
                "order by coalesce(last_activity_at, started_at) desc limit 1", (BOT_CHAT,)).fetchone()
        finally:
            db.close()
    except sqlite3.Error:
        return ""
    return str(row[0]) if row else ""


def clip(text) -> str:
    return str(text or "")[:TEXT_LIMIT]


class Emitter:
    """One JSON object per line on stdout; the only channel the shell reads."""

    def __init__(self, stream=None):
        self.stream = stream or sys.stdout

    def __call__(self, **event):
        self.stream.write(json.dumps(event, ensure_ascii=False) + "\n")
        self.stream.flush()


def log(message: str) -> None:
    print(f"hermes-blob-bridge: {message}", file=sys.stderr, flush=True)


class BotState:
    """Event bookkeeping for one bot's Bot Chat, independent of the transport (unit-tested)."""

    def __init__(self, bot: str, emit):
        self.bot = bot
        self.emit = emit
        self.session_id = ""
        self.generation = 0
        self.mine: dict[str, str] = {}        # admission id -> askId
        self.streams: dict[str, str] = {}     # admission id -> text so far
        self.held: list[dict] = []            # events seen while a submit's receipt is in flight
        self.submitting = 0
        self.asked: dict[str, str] = {}       # admission id -> the question, for turns started elsewhere
        self.prompts: dict[str, dict] = {}    # open approvals / questions by prompt id
        self.asks_by_prompt: dict[str, str] = {}

    def prompt(self, payload: dict, ask=None) -> None:
        """An approval or clarifying question the gateway is waiting on."""
        prompt_id = str(payload.get("prompt_id") or "")
        if not prompt_id:
            return
        kind = "clarify" if payload.get("kind") == "clarify" or "question" in payload else "approval"
        self.prompts[prompt_id] = {"kind": kind, "generation": payload.get("execution_generation", self.generation)}
        extra = {"askId": ask} if ask else {}
        if ask:
            self.asks_by_prompt[prompt_id] = ask
        choices = [str(c)[:120] for c in (payload.get("choices") or []) if str(c).strip()][:8]
        event = dict(ev="prompt", bot=self.bot, promptId=prompt_id, kind=kind, choices=choices,
                     multiSelect=bool(payload.get("multi_select")), **extra)
        if kind == "approval":
            event["text"] = clip(payload.get("description") or "Run this command?")
            if payload.get("command"):
                event["command"] = clip(payload.get("command"))[:2000]
        else:
            event["text"] = clip(payload.get("question") or "")
        self.emit(**event)

    def settled(self, prompt_id: str) -> None:
        if self.prompts.pop(prompt_id, None) is not None:
            self.asks_by_prompt.pop(prompt_id, None)
            self.emit(ev="settled", bot=self.bot, promptId=prompt_id)

    def attached(self, snapshot: dict) -> None:
        """The recent conversation, then any prompts already open when this viewer attached."""
        self.emit(ev="history", bot=self.bot, items=history_items(snapshot.get("messages")))
        open_now = {str(p.get("prompt_id")): p for p in snapshot.get("prompts") or [] if isinstance(p, dict)}
        for prompt_id in list(self.prompts):
            if prompt_id not in open_now:
                self.settled(prompt_id)
        for prompt_id, payload in open_now.items():
            if prompt_id not in self.prompts:
                self.prompt(payload)

    def own(self, admission: str, ask_id: str) -> None:
        """A submit's receipt arrived: replay what the owner published before it."""
        self.mine[admission] = ask_id
        self.submitting = max(0, self.submitting - 1)
        held, self.held = self.held, []
        for params in held:
            self.handle(params)

    def submit_failed(self) -> None:
        self.submitting = max(0, self.submitting - 1)
        held, self.held = self.held, []
        for params in held:
            self.handle(params)

    def handle(self, params: dict) -> bool:
        """Apply one event frame's params. Returns False when the session must be re-attached."""
        if params.get("session_id") != self.session_id:
            return True
        kind = params.get("type")
        payload = params.get("payload") or {}
        if isinstance(params.get("execution_generation"), int):
            self.generation = params["execution_generation"]
        if kind == "session.replay_gap":
            return False
        if kind == "session.info":
            if isinstance(payload.get("execution_generation"), int):
                self.generation = payload["execution_generation"]
            for row in payload.get("pending") or []:
                if isinstance(row, dict) and row.get("admission_id") and isinstance(row.get("text"), str):
                    self.asked.setdefault(row["admission_id"], strip_note(row["text"])[:4000])
            return True
        if kind in ("approval.settled", "clarify.settled"):
            self.settled(str(payload.get("prompt_id") or ""))
            return True
        admission = params.get("admission_id") or payload.get("admission_id") or ""
        if not admission and kind in ("approval.request", "clarify.request"):
            self.prompt({**payload, "kind": "clarify" if kind == "clarify.request" else "approval"})
            return True
        if not admission:
            return True
        if admission not in self.mine and self.submitting:
            self.held.append(params)
            return True
        ask = self.mine.get(admission)
        extra = {"askId": ask} if ask else {}
        if kind == "message.start":
            self.streams[admission] = ""
        elif kind == "message.delta":
            text = payload.get("text") or payload.get("delta") or payload.get("content") or ""
            if isinstance(text, str) and text:
                self.streams[admission] = clip(self.streams.get(admission, "") + text)
                self.emit(ev="delta", bot=self.bot, text=self.streams[admission].strip(), **extra)
        elif kind == "tool.start":
            # Text streamed before a tool call is commentary the final reply does not repeat.
            self.streams[admission] = ""
            self.emit(ev="progress", bot=self.bot, text=tool_label(payload), **extra)
        elif kind == "tool.complete":
            self.emit(ev="progress", bot=self.bot, text="Thinking…", **extra)
        elif kind == "thinking.delta":
            status = str(payload.get("text") or "").strip()
            if status and not self.streams.get(admission):
                self.emit(ev="progress", bot=self.bot, text=status[:120], **extra)
        elif kind in ("approval.request", "clarify.request"):
            self.prompt({**payload, "kind": "clarify" if kind == "clarify.request" else "approval"}, ask)
        elif kind == "message.complete":
            text = payload.get("text") or payload.get("content") or self.streams.get(admission, "")
            self.streams.pop(admission, None)
            self.mine.pop(admission, None)
            asked = self.asked.pop(admission, "")
            status = str(payload.get("status") or payload.get("outcome") or "complete")
            text = clip(text).strip()
            if SILENCE.match(text):
                text = ""
            if not text and ask is None:
                return True  # an empty turn nobody here asked for (a [SILENT] wake): nothing to show
            if ask is None and asked:
                extra = {"asked": asked}
            self.emit(ev="complete", bot=self.bot, text=text, status=status, **extra)
        return True


class BotLink:
    """Keeps one profile's Bot Chat attached, reconnecting with backoff."""

    def __init__(self, bridge: "Bridge", bot: str, home: Path):
        self.bridge = bridge
        self.bot = bot
        self.home = home
        self.state = BotState(bot, bridge.emit)
        self.client = None
        self.up = asyncio.Event()
        self.task = asyncio.create_task(self.run())

    async def run(self) -> None:
        delay = RETRY_MIN
        while True:
            try:
                await self.attach_once()
                delay = RETRY_MIN
            except asyncio.CancelledError:
                raise
            except Exception as exc:  # any transport failure: report, back off, retry
                self.bridge.emit(ev="status", bot=self.bot, state="down", detail=str(exc)[:200])
                log(f"{self.bot}: {type(exc).__name__}: {str(exc)[:200]}")
            finally:
                self.client = None
                self.up.clear()
            await asyncio.sleep(delay)
            delay = min(RETRY_MAX, delay * 2)

    async def attach_once(self) -> None:
        from websockets.asyncio.client import connect
        from hermes_cli.gateway_client import (GATEWAY_WS_PROTOCOL, GatewayClient, _session_ticket,
                                               gateway_ws_target)
        from hermes_cli.gateway_runtime import attachable, ensure_gateway_runtime

        session_id = await asyncio.to_thread(bot_chat_id, self.home)
        if not session_id:
            raise RuntimeError("no Bot Chat yet: open this bot once in Hermes Desktop or the CLI")
        result = await asyncio.to_thread(ensure_gateway_runtime, self.home, idle_exit=True)
        if not attachable(result):
            raise RuntimeError(f"gateway {result.state}: {result.reason_code or 'not ready'}")
        ticket = await asyncio.to_thread(_session_ticket, self.home, result.endpoint)
        url, protocols = gateway_ws_target(result.endpoint, ticket)
        async with connect(url, subprotocols=protocols, open_timeout=10, max_size=8 * 1024 * 1024,
                           proxy=None) as ws:
            if ws.subprotocol != GATEWAY_WS_PROTOCOL:
                raise RuntimeError("gateway protocol mismatch; update or restart Hermes")
            async with GatewayClient(ws) as client:
                try:
                    snapshot = await client.rpc("session.resume", session_id=session_id)
                except Exception as exc:
                    data = getattr(exc, "data", None) or {}
                    if "cwd" in (data.get("fields") or [data.get("field")]):
                        raise RuntimeError("its Bot Chat's saved working folder no longer exists; "
                                           "reopen the Bot Chat in Hermes to repair it") from None
                    raise
                self.state.session_id = snapshot.get("stored_session_id") or session_id
                self.state.generation = snapshot.get("execution_generation") or 0
                self.client = client
                self.state.attached(snapshot)
                self.up.set()
                self.bridge.emit(ev="status", bot=self.bot, state="up")
                while True:
                    event = await client.events.get()
                    if isinstance(event, Exception):
                        raise RuntimeError("gateway disconnected")
                    if not self.state.handle(event.get("params") or {}):
                        raise RuntimeError("replay gap; re-attaching")

    async def ask(self, ask_id: str, text: str) -> None:
        client = self.client
        if client is None:
            self.bridge.emit(ev="error", bot=self.bot, askId=ask_id, code="unavailable",
                             text="Not connected to Hermes yet.")
            return
        self.state.submitting += 1
        try:
            receipt = await client.rpc("prompt.submit", session_id=self.state.session_id,
                                       input_id=uuid.uuid4().hex, text=NOTE + "\n\n" + text)
        except Exception as exc:
            self.state.submit_failed()
            self.bridge.emit(ev="error", bot=self.bot, askId=ask_id, code="refused",
                             text=f"Hermes refused the ask ({str(exc)[:120]}).")
            return
        admission = (receipt or {}).get("admission_id")
        if not admission:
            self.state.submit_failed()
            self.bridge.emit(ev="error", bot=self.bot, askId=ask_id, code="refused",
                             text="Hermes did not accept the ask.")
            return
        self.state.own(admission, ask_id)

    async def respond(self, prompt_id: str, value: str, kind: str) -> None:
        client = self.client
        prompt = self.state.prompts.get(prompt_id)
        if client is None or prompt is None or prompt["kind"] != kind:
            self.bridge.emit(ev="responded", bot=self.bot, promptId=prompt_id, ok=False,
                             text="That request is no longer waiting.")
            return
        field = {"choice": value} if kind == "approval" else {"answer": value}
        try:
            await client.rpc(f"{kind}.respond", session_id=self.state.session_id,
                             execution_generation=prompt["generation"], prompt_id=prompt_id, **field)
        except Exception as exc:
            self.bridge.emit(ev="responded", bot=self.bot, promptId=prompt_id, ok=False,
                             text=f"Hermes didn't take the answer ({str(exc)[:80]}).")
            return
        self.bridge.emit(ev="responded", bot=self.bot, promptId=prompt_id, ok=True)
        self.state.settled(prompt_id)

    async def compact(self) -> None:
        client = self.client
        if client is None:
            self.bridge.emit(ev="compacted", bot=self.bot, ok=False, text="Not connected to Hermes yet.")
            return
        from hermes_cli.gateway_mutations import PreparedMutations
        try:
            result = await PreparedMutations().apply(client, self.state.session_id, "compress", {})
        except Exception as exc:
            reason = str(exc)[:80]
            text = ("Nothing to compact yet." if reason == "nothing_to_compress" else
                    "It's busy; compact when the current turn ends." if reason == "session_busy" else
                    f"Compacting failed ({reason}).")
            self.bridge.emit(ev="compacted", bot=self.bot, ok=False, text=text)
            return
        status = str((result or {}).get("status") or "done")
        self.bridge.emit(ev="compacted", bot=self.bot, ok=status not in ("nothing", "cancelled"),
                         text="Conversation compacted: same chat, fresh working context." if status not in
                         ("nothing", "cancelled") else "Nothing to compact yet.")

    async def stop(self) -> None:
        client = self.client
        if client is None:
            return
        try:
            await client.rpc("session.interrupt", session_id=self.state.session_id,
                             execution_generation=self.state.generation)
        except Exception as exc:
            log(f"{self.bot}: interrupt failed: {type(exc).__name__}")


class Bridge:
    def __init__(self, emit):
        self.emit = emit
        self.conf = desktop_config()
        self.root = hermes_root(self.conf)
        self.links: dict[str, BotLink] = {}

    def sync_links(self) -> None:
        wanted = roster_profiles(self.root)
        for bot in list(self.links):
            if bot not in wanted:
                self.links.pop(bot).task.cancel()
        for bot in wanted:
            if bot not in self.links:
                self.links[bot] = BotLink(self, bot, profile_home(self.root, bot))

    async def command(self, line: str) -> None:
        try:
            msg = json.loads(line)
        except ValueError:
            return
        if not isinstance(msg, dict):
            return
        op = msg.get("op")
        bot = str(msg.get("bot") or "")
        if op == "reload":
            self.sync_links()
            return
        link = self.links.get(bot)
        if op == "ask":
            ask_id = str(msg.get("askId") or "")
            text = str(msg.get("text") or "").replace("\x00", "").strip()
            if not ASK_ID.fullmatch(ask_id) or not text:
                return
            if link is None:
                self.emit(ev="error", bot=bot, askId=ask_id, code="unavailable",
                          text="This bot isn't a Hermes profile the bridge knows.")
                return
            asyncio.create_task(link.ask(ask_id, text[:TEXT_LIMIT]))
        elif op == "stop" and link is not None:
            asyncio.create_task(link.stop())
        elif op in ("respond", "answer") and link is not None:
            prompt_id = str(msg.get("promptId") or "")[:128]
            value = str(msg.get("choice" if op == "respond" else "answer") or "").replace("\x00", "").strip()
            if prompt_id and value:
                asyncio.create_task(link.respond(prompt_id, value[:TEXT_LIMIT],
                                                 "approval" if op == "respond" else "clarify"))
        elif op == "compact" and link is not None:
            asyncio.create_task(link.compact())

    async def run(self) -> None:
        self.sync_links()
        self.emit(ev="ready")
        loop = asyncio.get_running_loop()
        reader = asyncio.StreamReader(limit=1024 * 1024)
        await loop.connect_read_pipe(lambda: asyncio.StreamReaderProtocol(reader), sys.stdin)
        while True:
            line = await reader.readline()
            if not line:
                return  # the shell went away
            await self.command(line.decode("utf-8", errors="replace"))


def main() -> int:
    conf = desktop_config()
    agent = str(conf.get("hermesAgentDir") or os.path.join(os.environ.get("HOME", ""), ".hermes", "hermes-agent"))
    if not agent.startswith("/") or not os.path.isfile(os.path.join(agent, "hermes_cli", "gateway_client.py")):
        log("Hermes Agent source not found; set hermesAgentDir")
        return 3
    sys.path.insert(0, agent)
    try:
        asyncio.run(Bridge(Emitter()).run())
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
